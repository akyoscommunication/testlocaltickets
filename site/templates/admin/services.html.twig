{% extends 'base.html.twig' %}

{% block title %}Services ticket{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl p-6">
    <h1 class="text-2xl font-semibold mb-2">Services ticket</h1>
    <p class="text-sm text-muted-foreground mb-6">Actions invocables par l’IA via <code>service_request</code> (schéma triage v2).</p>

    <div class="space-y-4">
        {% for item in services %}
        <article class="rounded-lg border bg-card shadow-sm overflow-hidden">
            <header class="border-b px-4 py-3 flex flex-wrap justify-between items-center gap-2">
                <div>
                    <h2 class="font-mono font-semibold">{{ item.key }}</h2>
                    <p class="text-sm text-muted-foreground">{{ item.label }}</p>
                </div>
                <div class="flex gap-2 text-xs">
                    <span class="rounded-full bg-muted px-2 py-0.5">{{ item.category }}</span>
                    {% if item.relaunch_ia %}
                        <span class="rounded-full bg-blue-100 text-blue-800 px-2 py-0.5">Relance IA</span>
                    {% else %}
                        <span class="rounded-full bg-gray-100 text-gray-700 px-2 py-0.5">Terminal</span>
                    {% endif %}
                </div>
            </header>
            <div class="p-4 text-sm space-y-2">
                <p>{{ item.description }}</p>
                <p class="text-muted-foreground"><strong>Params :</strong> <code>{{ item.params }}</code></p>
            </div>
        </article>
        {% endfor %}
    </div>
</div>
{% endblock %}
