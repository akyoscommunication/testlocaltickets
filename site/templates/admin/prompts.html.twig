{% extends 'base.html.twig' %}

{% block title %}Catalogue prompts{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl p-6">
    <h1 class="text-2xl font-semibold mb-2">Catalogue prompts</h1>
    <p class="text-sm text-gray-600 mb-6">Lecture seule — définition dans <code>config/packages/prompts.yaml</code>.</p>

    <div class="space-y-6">
        {% for item in catalog %}
        <article class="rounded-lg border bg-white shadow-sm overflow-hidden">
            <header class="border-b bg-gray-50 px-4 py-3 flex justify-between items-center">
                <h2 class="font-mono font-semibold">{{ item.key }}</h2>
                <span class="text-xs rounded-full bg-blue-100 text-blue-800 px-2 py-0.5">v{{ item.version }}</span>
            </header>
            <div class="p-4 space-y-4 text-sm">
                <div>
                    <h3 class="font-medium text-gray-700 mb-1">System</h3>
                    <p class="text-xs text-gray-500 mb-1"><code>{{ item.system_path }}</code></p>
                    <pre class="bg-gray-50 rounded p-3 text-xs max-h-48 overflow-auto whitespace-pre-wrap">{{ item.system ?? '(fichier manquant)' }}</pre>
                </div>
                <div>
                    <h3 class="font-medium text-gray-700 mb-1">User (template)</h3>
                    <p class="text-xs text-gray-500 mb-1"><code>{{ item.user_path }}</code></p>
                    <pre class="bg-gray-50 rounded p-3 text-xs max-h-48 overflow-auto whitespace-pre-wrap">{{ item.user ?? '(fichier manquant)' }}</pre>
                </div>
            </div>
        </article>
        {% endfor %}
    </div>
</div>
{% endblock %}
