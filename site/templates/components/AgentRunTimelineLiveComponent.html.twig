<div{{ attributes }} class="space-y-3">
    {% set runs = this.runs %}
    {% if runs is empty %}
        <p class="text-sm text-gray-500">Aucun run agent pour ce ticket.</p>
    {% else %}
        <ol class="relative border-l border-gray-200 ml-3 space-y-4">
            {% for run in runs %}
            <li class="ml-6">
                <span class="absolute -left-1.5 mt-1.5 h-3 w-3 rounded-full bg-blue-500 ring-4 ring-white"></span>
                <div class="rounded-lg border bg-white p-3 shadow-sm">
                    <div class="flex flex-wrap items-center gap-2 text-sm">
                        <strong class="font-mono">{{ run.runId }}</strong>
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs">{{ run.phase }}</span>
                        <span class="rounded-full px-2 py-0.5 text-xs {{ run.status == 'completed' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' }}">{{ run.status }}</span>
                        {% if run.durationMs %}<span class="text-gray-500 text-xs">{{ run.durationMs }} ms</span>{% endif %}
                    </div>
                    <p class="text-xs text-gray-500 mt-1">{{ run.templateKey }} v{{ run.templateVersion }}</p>
                    {% if run.responsePath %}
                        <p class="text-xs mt-1"><span class="text-gray-500">JSON :</span> <code class="bg-gray-50 px-1 rounded">{{ run.responsePath }}</code></p>
                    {% endif %}
                    {% if run.renderedPromptPath %}
                        <button type="button" class="mt-2 text-xs text-blue-600 hover:underline"
                            data-action="live#action"
                            data-live-action-param="togglePrompt"
                            data-live-run-id-param="{{ run.runId }}">
                            {{ expandedRunId == run.runId ? 'Masquer' : 'Afficher' }} le prompt
                        </button>
                        {% if expandedRunId == run.runId %}
                            <pre class="mt-2 max-h-64 overflow-auto rounded bg-gray-50 p-3 text-xs whitespace-pre-wrap">{{ expandedPrompt ?? '(fichier introuvable)' }}</pre>
                        {% endif %}
                    {% endif %}
                </div>
            </li>
            {% endfor %}
        </ol>
    {% endif %}
</div>
